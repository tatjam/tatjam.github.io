Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveSystem", "[", 
    RowBox[{
    "eqs_", ",", "initialConditions_", ",", "lambda_", ",", "constants_"}], 
    "]"}], ":=", 
   RowBox[{"Block", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "centralLambdaConditions", ",", "simplifyAbs", ",", "systemCentral", ",",
        "slnCentral", ",", "desiredLambda", ",", "\[Phi]"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"simplifyAbs", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Abs", "[", "x_", "]"}], "->", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"x", "^", "2"}], "]"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"centralLambdaConditions", "=", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Lambda]r", "[", "0", "]"}], "==", 
          RowBox[{"lambda", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[Lambda]\[Theta]", "[", "0", "]"}], "==", 
          RowBox[{"lambda", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[Lambda]vs", "[", "0", "]"}], "==", 
          RowBox[{"lambda", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[Lambda]vr", "[", "0", "]"}], "==", 
          RowBox[{"lambda", "[", 
           RowBox[{"[", "4", "]"}], "]"}]}]}], "\[IndentingNewLine]", "}"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"systemCentral", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
          "eqs", ",", "initialConditions", ",", "centralLambdaConditions"}], 
          "]"}], "/.", "constants"}], "/.", "simplifyAbs"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"NDSolveValue", "[", 
       RowBox[{"systemCentral", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"r", "[", "t", "]"}], ",", 
          RowBox[{"\[Theta]", "[", "t", "]"}], ",", 
          RowBox[{"vs", "[", "t", "]"}], ",", 
          RowBox[{"vr", "[", "t", "]"}], ",", 
          RowBox[{"\[Alpha]", "[", "t", "]"}], ",", 
          RowBox[{"\[Lambda]r", "[", "t", "]"}], ",", 
          RowBox[{"\[Lambda]\[Theta]", "[", "t", "]"}], ",", 
          RowBox[{"\[Lambda]vs", "[", "t", "]"}], ",", 
          RowBox[{"\[Lambda]vr", "[", "t", "]"}]}], "}"}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "tf"}], "}"}], "/.", "constants"}], ",", 
        RowBox[{"WorkingPrecision", "->", "MachinePrecision"}], ",", 
        RowBox[{"PrecisionGoal", "->", "3"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9603398855895987`*^9, 3.960339913744679*^9}, {
  3.9603399549652576`*^9, 3.960339955873255*^9}, {3.960341373182252*^9, 
  3.9603413799965887`*^9}},
 CellLabel->
  "In[343]:=",ExpressionUUID->"3afb5214-9a48-4c22-947d-8be6b69376b8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FinalLambdaError", "[", 
    RowBox[{"eqs_", ",", " ", "initialConditions_", ",", 
     RowBox[{"lambda_", "/;", 
      RowBox[{"VectorQ", "[", 
       RowBox[{"lambda", ",", "NumericQ"}], "]"}]}], ",", "constants_"}], " ",
     "]"}], ":=", 
   RowBox[{"Block", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"slnCentral", ",", "desiredLambda", ",", "\[Phi]"}], "}"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"slnCentral", "=", 
