             RowBox[{"\[Alpha]", "[", "t", "]"}], "-", 
             RowBox[{"\[Theta]", "[", "t", "]"}]}], "]"}]}]}], "m"], "-", 
        FractionBox[
         RowBox[{
          RowBox[{"vr", "[", "t", "]"}], " ", 
