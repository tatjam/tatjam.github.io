Cell[BoxData[
 RowBox[{
  RowBox[{"constants", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"A", "->", "1"}], 
     RowBox[{"(*", "m\.b2", "*)"}], ",", "\[IndentingNewLine]", 
     RowBox[{"p", "->", "1"}], " ", 
     RowBox[{"(*", 
      RowBox[{
      "Momentum", " ", "flux", " ", "of", " ", "incoming", " ", "light", " ", 
       "per", " ", "unit", " ", "area", " ", 
       RowBox[{"(", 
        RowBox[{"THINK", "!"}], ")"}]}], "*)"}], ",", "\[IndentingNewLine]", 
     RowBox[{"m", "->", "10"}], " ", 
     RowBox[{"(*", "kg", "*)"}], ",", "\[IndentingNewLine]", 
     RowBox[{"\[Mu]", "->", 
      RowBox[{"3.986004418", "*", 
       SuperscriptBox["10", "14"]}]}], " ", 
     RowBox[{"(*", 
      RowBox[{"m\.b3", "/", "s\.b2"}], "*)"}], ",", "\[IndentingNewLine]", 
     RowBox[{"\[Epsilon]", "->", "0.6"}], ",", "\[IndentingNewLine]", 
     RowBox[{"r0", "->", 
      RowBox[{"7000", "*", 
       SuperscriptBox["10", "3"]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"tf", "->", "10000"}]}], "}"}]}], ";"}]], "Input",
