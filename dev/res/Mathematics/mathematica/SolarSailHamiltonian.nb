         RowBox[{
          RowBox[{"vs", "'"}], "[", "t", "]"}], ",", 
         RowBox[{
          RowBox[{"vr", "'"}], "[", "t", "]"}]}], "}"}], ",", "f"}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eqLambda", "=", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"#1", "==", "#2"}], "&"}], ",", 
     RowBox[{"{", 
