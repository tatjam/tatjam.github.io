Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Block", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"root", "=", 
     RowBox[{"FindRoot", "[", 
      RowBox[{
       RowBox[{"FinalLambdaError", "[", 
        RowBox[{"eqs", ",", "circularInitialConditions", ",", 
         RowBox[{"{", 
          RowBox[{
          "\[Lambda]rv", ",", "\[Lambda]\[Theta]v", ",", "\[Lambda]vsv", ",", 
           "\[Lambda]vrv"}], "}"}], ",", "constants"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Lambda]rv", ",", 
           RowBox[{"\[Lambda]rv", "/.", "root"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Lambda]\[Theta]v", ",", 
           RowBox[{"\[Lambda]\[Theta]v", "/.", "root"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Lambda]vsv", ",", 
           RowBox[{"\[Lambda]vsv", "/.", "root"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Lambda]vrv", ",", 
           RowBox[{"\[Lambda]vrv", "/.", "root"}]}], "}"}]}], "}"}], ",", 
       RowBox[{"MaxIterations", "->", "1"}], ",", 
       RowBox[{"Method", "->", "\"\<Automatic\>\""}], ",", 
       RowBox[{"WorkingPrecision", "->", "MachinePrecision"}]}], "]"}]}], ";",
     "\[IndentingNewLine]", 
    RowBox[{"Print", "[", "root", "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"sln", "=", 
     RowBox[{"SolveSystem", "[", 
      RowBox[{"eqs", ",", "circularInitialConditions", ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "\[Lambda]rv", ",", "\[Lambda]\[Theta]v", ",", "\[Lambda]vsv", ",", 
          "\[Lambda]vrv"}], "}"}], "/.", "root"}], ",", "constants"}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Phi]", "[", "t_", "]"}], ":=", 
     RowBox[{
      RowBox[{
       FractionBox["1", "2"], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"vr", "[", "t", "]"}], "^", "2"}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"r", "[", "t", "]"}], "*", 
            RowBox[{"vs", "[", "t", "]"}]}], ")"}], "2"}]}], ")"}]}], "-", 
      FractionBox["\[Mu]", 
       RowBox[{"r", "[", "t", "]"}]]}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"desiredLambda", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"\[Phi]", "[", "tf", "]"}], ",", 
            RowBox[{"r", "[", "tf", "]"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"\[Phi]", "[", "tf", "]"}], ",", 
            RowBox[{"\[Theta]", "[", "tf", "]"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"\[Phi]", "[", "tf", "]"}], ",", 
            RowBox[{"vs", "[", "tf", "]"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"\[Phi]", "[", "tf", "]"}], ",", 
            RowBox[{"vr", "[", "tf", "]"}]}], "]"}]}], "\[IndentingNewLine]", 
         "}"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"r", "[", "tf", "]"}], "->", 
           RowBox[{"sln", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"\[Theta]", "[", "tf", "]"}], "->", 
           RowBox[{"sln", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"vs", "[", "tf", "]"}], "->", 
           RowBox[{"sln", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"vr", "[", "tf", "]"}], "->", 
           RowBox[{"sln", "[", 
            RowBox[{"[", "4", "]"}], "]"}]}]}], "}"}]}], "/.", 
       RowBox[{"t", "->", "tf"}]}], "/.", "constants"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Desired \[Lambda]r = \>\"", ",", 
      RowBox[{"desiredLambda", "[", 
       RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<, calculated = \>\"", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"sln", "[", 
         RowBox[{"[", "6", "]"}], "]"}], "/.", 
        RowBox[{"t", "->", "tf"}]}], "/.", "constants"}]}], "]"}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Print", "[", 
