  3.960339526259759*^9}, {3.960339571995069*^9, 3.960339581942628*^9}, {
  3.960339697761582*^9, 3.960339721289236*^9}, {3.960339921370833*^9, 
  3.960339947589014*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"0a07fc14-eeeb-437b-ba7f-c9dfa3f767b3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"monitoredFindRoot", "[", "args__", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"s", "=", "0"}], ",", 
      RowBox[{"e", "=", "0"}], ",", 
      RowBox[{"j", "=", "0"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"FindRoot", "[", 
       RowBox[{"args", ",", 
        RowBox[{"StepMonitor", ":>", 
         RowBox[{"s", "++"}]}], ",", 
        RowBox[{"EvaluationMonitor", ":>", 
         RowBox[{"e", "++"}]}], ",", 
        RowBox[{"Jacobian", "->", 
         RowBox[{"{", 
          RowBox[{"Automatic", ",", 
           RowBox[{"EvaluationMonitor", ":>", 
            RowBox[{"j", "++"}]}]}], "}"}]}]}], "]"}], ",", 
      RowBox[{"\"\<Steps\>\"", "->", "s"}], ",", 
      RowBox[{"\"\<Evaluations\>\"", "->", "e"}], ",", 
      RowBox[{"\"\<Jacobian Evaluations\>\"", "->", "j"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[22]:=",ExpressionUUID->"aeca1c9a-9117-474c-9983-12b52426960e"],

