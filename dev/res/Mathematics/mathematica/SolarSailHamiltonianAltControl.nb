 CellLabel->"In[17]:=",ExpressionUUID->"618bfc4b-e56a-4261-af54-d03ea48fd946"],

Cell[BoxData[
 RowBox[{
  RowBox[{"circularInitialConditions", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Theta]", "[", "0", "]"}], "==", "0"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"r", "[", "0", "]"}], "==", "r0"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{
      RowBox[{"vs", "[", "0", "]"}], "==", 
      RowBox[{"Sqrt", "[", 
       FractionBox["\[Mu]", "r0"], "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"vr", "[", "0", "]"}], "==", "0"}]}], "\[IndentingNewLine]", 
    "}"}]}], ";"}]], "Input",
 CellLabel->"In[18]:=",ExpressionUUID->"ceb7bff4-ce9f-45e2-9a76-dbf0c91a23a4"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{"Returns", " ", 
     RowBox[{"\[Lambda]", "[", "tf", "]"}], 
     RowBox[{"(", "desired", ")"}]}], "-", 
    RowBox[{
     RowBox[{"\[Lambda]", "[", "tf", "]"}], 
     RowBox[{"(", 
      RowBox[{"assuming", " ", "\[Lambda]0"}], ")"}]}]}], ",", " ", 
   RowBox[{"to", " ", "be", " ", "used", " ", "with", " ", "FindRoot"}]}], 
  "*)"}]], "Input",
 CellChangeTimes->{{3.9603389843599253`*^9, 3.960339007917698*^9}, {
  3.960339123642682*^9, 3.960339124472938*^9}, {3.960339168921328*^9, 
  3.960339200949163*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"facb4a79-2478-4bff-a77a-7f219611c208"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SolveSystem", "[", 
    RowBox[{
    "eqs_", ",", "initialConditions_", ",", "lambda_", ",", "constants_"}], 
    "]"}], ":=", 
   RowBox[{"Block", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "centralLambdaConditions", ",", "simplifyAbs", ",", "systemCentral", ",",
        "slnCentral", ",", "desiredLambda", ",", "\[Phi]"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"simplifyAbs", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Abs", "[", "x_", "]"}], "->", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"x", "^", "2"}], "]"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"centralLambdaConditions", "=", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Lambda]r", "[", "0", "]"}], "==", 
          RowBox[{"lambda", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[Lambda]\[Theta]", "[", "0", "]"}], "==", 
          RowBox[{"lambda", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[Lambda]vs", "[", "0", "]"}], "==", 
          RowBox[{"lambda", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"\[Lambda]vr", "[", "0", "]"}], "==", 
          RowBox[{"lambda", "[", 
           RowBox[{"[", "4", "]"}], "]"}]}]}], "\[IndentingNewLine]", "}"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"systemCentral", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
          "eqs", ",", "initialConditions", ",", "centralLambdaConditions"}], 
          "]"}], "/.", "constants"}], "/.", "simplifyAbs"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"NDSolveValue", "[", 
       RowBox[{"systemCentral", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"r", "[", "t", "]"}], ",", 
          RowBox[{"\[Theta]", "[", "t", "]"}], ",", 
          RowBox[{"vs", "[", "t", "]"}], ",", 
          RowBox[{"vr", "[", "t", "]"}], ",", 
          RowBox[{"a", "[", "t", "]"}], ",", 
          RowBox[{"\[Lambda]r", "[", "t", "]"}], ",", 
          RowBox[{"\[Lambda]\[Theta]", "[", "t", "]"}], ",", 
          RowBox[{"\[Lambda]vs", "[", "t", "]"}], ",", 
          RowBox[{"\[Lambda]vr", "[", "t", "]"}]}], "}"}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "tf"}], "}"}], "/.", "constants"}], ",", 
        RowBox[{"WorkingPrecision", "->", "MachinePrecision"}], ",", 
        RowBox[{"PrecisionGoal", "->", "3"}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9603398855895987`*^9, 3.960339913744679*^9}, {
  3.9603399549652576`*^9, 3.960339955873255*^9}, {3.960341373182252*^9, 
  3.9603413799965887`*^9}, {3.96090651868146*^9, 3.9609065188880243`*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"3afb5214-9a48-4c22-947d-8be6b69376b8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"FinalLambdaError", "[", 
    RowBox[{"eqs_", ",", " ", "initialConditions_", ",", 
     RowBox[{"lambda_", "/;", 
      RowBox[{"VectorQ", "[", 
       RowBox[{"lambda", ",", "NumericQ"}], "]"}]}], ",", "constants_"}], " ",
     "]"}], ":=", 
   RowBox[{"Block", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"slnCentral", ",", "desiredLambda", ",", "\[Phi]"}], "}"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"slnCentral", "=", 
       RowBox[{"SolveSystem", "[", 
        RowBox[{
        "eqs", ",", "initialConditions", ",", "lambda", ",", "constants"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Phi]", "[", "t_", "]"}], ":=", 
       RowBox[{
        RowBox[{
         FractionBox["1", "2"], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"vr", "[", "t", "]"}], "^", "2"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"r", "[", "t", "]"}], "*", 
              RowBox[{"vs", "[", "t", "]"}]}], ")"}], "2"}]}], ")"}]}], "-", 
        FractionBox["\[Mu]", 
         RowBox[{"r", "[", "t", "]"}]]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"desiredLambda", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"\[Phi]", "[", "tf", "]"}], ",", 
              RowBox[{"r", "[", "tf", "]"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"\[Phi]", "[", "tf", "]"}], ",", 
              RowBox[{"\[Theta]", "[", "tf", "]"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"\[Phi]", "[", "tf", "]"}], ",", 
              RowBox[{"vs", "[", "tf", "]"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"\[Phi]", "[", "tf", "]"}], ",", 
              RowBox[{"vr", "[", "tf", "]"}]}], "]"}]}], 
           "\[IndentingNewLine]", "}"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"r", "[", "tf", "]"}], "->", 
             RowBox[{"slnCentral", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"\[Theta]", "[", "tf", "]"}], "->", 
             RowBox[{"slnCentral", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"vs", "[", "tf", "]"}], "->", 
             RowBox[{"slnCentral", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"vr", "[", "tf", "]"}], "->", 
             RowBox[{"slnCentral", "[", 
              RowBox[{"[", "4", "]"}], "]"}]}]}], "}"}]}], "/.", 
         RowBox[{"t", "->", "tf"}]}], "/.", "constants"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"desiredLambda", "-", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"slnCentral", "[", 
             RowBox[{"[", "6", "]"}], "]"}], ",", 
            RowBox[{"slnCentral", "[", 
             RowBox[{"[", "7", "]"}], "]"}], ",", 
            RowBox[{"slnCentral", "[", 
             RowBox[{"[", "8", "]"}], "]"}], ",", 
            RowBox[{"slnCentral", "[", 
             RowBox[{"[", "9", "]"}], "]"}]}], "}"}]}], "/.", 
         RowBox[{"t", "->", "tf"}]}], "/.", "constants"}], ")"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.960337377501903*^9, 3.960337845523612*^9}, {
  3.960337891753499*^9, 3.9603379661725063`*^9}, {3.960338015606866*^9, 
  3.960338027189527*^9}, {3.960338064762927*^9, 3.9603380697438917`*^9}, {
  3.960338122660046*^9, 3.960338713925353*^9}, {3.960338750026864*^9, 
  3.9603388268831463`*^9}, {3.96033897427722*^9, 3.960339258782362*^9}, {
